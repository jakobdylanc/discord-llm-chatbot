# Copy to .env and fill in. Never commit .env.

# Discord — create an app at https://discord.com/developers/applications
# Enable MESSAGE CONTENT INTENT. Invite URL is printed on bot start.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Comma-separated Discord snowflakes. Admins can /model /learn /act /brain.
DISCORD_ADMIN_IDS=

# Guild-scoped slash commands. Without this, commands are not synced unless
# ABBEY_ALLOW_GLOBAL_COMMANDS=1 (refuses the global-registration footgun).
DISCORD_DEV_GUILD_ID=
# ABBEY_ALLOW_GLOBAL_COMMANDS=1

# Optional override for SQLite + brain JSON (default ~/.abbey)
# ABBEY_DATA_PATH=
# Optional allowlists. Empty means allow everyone / every channel.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# SpaceXAI / xAI (default provider). https://console.x.ai
XAI_API_KEY=

# Optional extra providers
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
